# ============================================================
# SiteHunter AI — variáveis de ambiente (NÃO coloque segredos reais aqui)
# Copie para .env e preencha. Nunca faça commit do .env.
# ============================================================

# --- Banco de dados (obrigatório) ---
DATABASE_URL="postgresql://sitehunter:sitehunter@localhost:5432/sitehunter"

# --- Acesso ao painel (obrigatório) ---
ADMIN_USERNAME="admin"
# Gere com: npm run hash-password -- "sua-senha-forte"
ADMIN_PASSWORD_HASH=""
# Segredo longo e aleatório (ex.: openssl rand -base64 48). Usado para sessões e links de descadastro.
AUTH_SECRET=""

# --- URL pública do painel/servidor (obrigatório para publicação interna e descadastro) ---
# Ex.: https://sitehunter.seudominio.com.br
PUBLIC_BASE_URL=""

# --- Descoberta de empresas: Google Places API (New) ---
# Console: https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=""

# --- IA: Anthropic (Claude) — opcional; sem chave, usa gerador por templates ---
ANTHROPIC_API_KEY=""
# Modelo econômico por padrão; troque se quiser mais qualidade.
ANTHROPIC_MODEL="claude-haiku-5-5"

# --- Publicação na Vercel — opcional; sem token, usa publicação interna (/d/<slug>) ---
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""

# --- WhatsApp Business Platform (Cloud API) — opcional ---
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"

# --- E-mail (SMTP) — opcional ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- Validação em navegador (opcional): caminho do Chromium se o padrão do Playwright não existir ---
# CHROMIUM_EXECUTABLE_PATH="/usr/bin/chromium"

# --- Worker ---
WORKER_CONCURRENCY="2"
