generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Configurações não secretas editáveis pelo painel (segredos ficam em variáveis de ambiente).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum RunMode {
  SIMULATION
  REAL
}

enum RunStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELED
}

enum RunStage {
  DISCOVERY
  PRODUCTION
  REPORT
  DONE
}

model Run {
  id             String       @id @default(cuid())
  name           String
  mode           RunMode
  status         RunStatus    @default(PENDING)
  stage          RunStage     @default(DISCOVERY)
  config         Json
  estimate       Json?
  report         Json?
  notice         String?
  budgetExceeded Boolean      @default(false)
  error          String?
  createdAt      DateTime     @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  jobs           Job[]
  companies      RunCompany[]
  costs          CostEntry[]
  messages       Message[]
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  WAITING_CONFIG
  WAITING_AUTH
  SKIPPED
  CANCELED
}

model Job {
  id             String    @id @default(cuid())
  runId          String?
  run            Run?      @relation(fields: [runId], references: [id], onDelete: Cascade)
  companyId      String?
  type           String
  status         JobStatus @default(PENDING)
  payload        Json      @default("{}")
  result         Json?
  priority       Int       @default(100)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  idempotencyKey String    @unique
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finishedAt     DateTime?

  @@index([status, runAt])
  @@index([runId, status])
}

enum PresenceStatus {
  PENDING
  FUNCTIONAL
  PROBLEMS
  NOT_FOUND
  INCONCLUSIVE
}

enum CrmStatus {
  NOVO_LEAD
  ANALISADO
  DEMO_GERADA
  DEMO_PUBLICADA
  CONTATO_PREPARADO
  CONTATO_REALIZADO
  RESPONDEU
  INTERESSADO
  NEGOCIACAO
  CLIENTE
  SEM_INTERESSE
  NAO_CONTATAR
}

model Company {
  id                 String         @id @default(cuid())
  source             String
  sourceId           String
  sourceUrl          String?
  attribution        String?
  isSimulated        Boolean        @default(false)
  name               String
  normalizedName     String
  category           String?
  niche              String?
  address            String?
  neighborhood       String?
  city               String?
  state              String?
  country            String?
  phone              String?
  phoneNormalized    String?
  phoneIsMobile      Boolean        @default(false)
  email              String?
  website            String?
  businessStatus     String?
  openingHours       Json?
  ratingCount        Int?
  collectedAt        DateTime       @default(now())
  dataExpiresAt      DateTime?
  verificationStatus String         @default("NAO_VERIFICADO")
  presenceStatus     PresenceStatus @default(PENDING)
  presenceDetails    Json?
  score              Int?
  scoreReasons       Json?
  crmStatus          CrmStatus      @default(NOVO_LEAD)
  doNotContact       Boolean        @default(false)
  notes              String?
  nextAction         String?
  lastActivityAt     DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  runs               RunCompany[]
  site               DemoSite?
  messages           Message[]
  events             ContactEvent[]

  @@unique([source, sourceId])
  @@index([phoneNormalized])
  @@index([normalizedName, city])
  @@index([crmStatus])
}

model RunCompany {
  runId     String
  companyId String
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  selected  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([runId, companyId])
}

enum SiteStatus {
  GENERATING
  GENERATED
  VALIDATED
  INVALID
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  SIMULATED
  UNPUBLISHED
}

model DemoSite {
  id            String     @id @default(cuid())
  companyId     String     @unique
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug          String     @unique
  status        SiteStatus @default(GENERATING)
  template      String?
  content       Json?
  contentSource String?
  html          String?
  validation    Json?
  publisher     String?
  publicUrl     String?
  providerRef   String?
  error         String?
  publishedAt   DateTime?
  unpublishedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum Channel {
  WHATSAPP
  EMAIL
  MANUAL
}

enum MessageStatus {
  DRAFT
  BLOCKED
  WAITING_CONFIG
  QUEUED
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
  NEEDS_VERIFICATION
  SIMULATED
  CANCELED
}

model Message {
  id                String        @id @default(cuid())
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  runId             String?
  run               Run?          @relation(fields: [runId], references: [id], onDelete: SetNull)
  channel           Channel
  recipient         String?
  subject           String?
  body              String
  bodySource        String?
  status            MessageStatus @default(DRAFT)
  blockReason       String?
  alternative       String?
  consentBasis      String?
  idempotencyKey    String        @unique
  providerMessageId String?       @unique
  attempts          Int           @default(0)
  error             String?
  sentAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([channel, status, sentAt])
}

model ContactEvent {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      String
  channel   String?
  content   String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
}

/// Registro de autorização (opt-in) para contato em um canal. Telefones públicos NÃO são opt-in.
model Consent {
  id        String    @id @default(cuid())
  channel   Channel
  contact   String
  basis     String
  evidence  String?
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@unique([channel, contact])
}

/// Lista de supressão/bloqueio. Guarda apenas hash do contato para não manter dados pessoais.
model Suppression {
  id        String   @id @default(cuid())
  valueHash String   @unique
  label     String?
  reason    String
  createdAt DateTime @default(now())
}

model CostEntry {
  id            String   @id @default(cuid())
  runId         String?
  run           Run?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  provider      String
  operation     String
  units         Float
  unitPrice     Float?
  estimatedCost Float    @default(0)
  priceKnown    Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([runId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AuthThrottle {
  key         String   @id
  count       Int
  windowStart DateTime
}
